# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
# Every value here is environment-specific and must never be committed.

# --- How clients reach this server. Decides what is required below. ---
# `http` (default) runs a listener, which is what the deployed stack uses.
# `stdio` lets a client start this process and speak over its pipes: no port,
# so no token and no Host allow-list are needed. Everything else - the outbound
# address policy, the fetch budget, the response size cap - is identical, and
# both modes expose exactly the same eight tools.
MCP_TRANSPORT=

# --- Required. The server refuses to start without these. ---
# Pre-shared bearer token that MCP clients must present.
# Not required when MCP_TRANSPORT=stdio: there is no listener to defend.
MCP_AUTH_TOKEN=
# Comma-separated hostnames accepted in Host/Origin on the MCP route.
# Not required when MCP_TRANSPORT=stdio, for the same reason.
MCP_ALLOWED_HOSTS=
# The URL MCP clients connect to, including the path. Used by
# install_claude_plugin.sh; not read by the server itself.
# Example: https://mcp.example.com/mcp-searxng-crawl4ai
MCP_PUBLIC_ENDPOINT=
# The token that endpoint enforces. Leave empty while MCP_PUBLIC_ENDPOINT points
# at the stack this checkout runs, and MCP_AUTH_TOKEN is used instead. Set it
# once the endpoint is a deployed host with its own token.
MCP_PUBLIC_AUTH_TOKEN=
# SearXNG server.secret_key.
SEARXNG_SECRET=
# Crawl4AI API token. This is not optional: without it Crawl4AI binds only to
# loopback inside its own container and is unreachable from the MCP server,
# while still reporting itself healthy.
CRAWL4AI_API_TOKEN=

# --- Optional. Sensible defaults apply when unset. ---
# Port the MCP server listens on inside the container.
PORT=
# Credentials for LLM-backed structured extraction. When empty, web_extract
# degrades to returning page markdown and every other tool is unaffected.
GEMINI_API_KEY=
# LiteLLM-style provider/model identifier, e.g. gemini/<model>.
GEMINI_MODEL=
# Route outbound traffic through a relay. Empty means connect directly.
PROXY_URL=
# Extra CIDR ranges to allow as scrape targets, comma-separated. Private,
# loopback, link-local and metadata ranges are denied unless listed here.
SCRAPE_ALLOW_CIDRS=
# Maximum simultaneous page fetches. Lower this on low-power hosts.
MAX_CONCURRENT_FETCHES=
# Attempts against an upstream, including the first. Default 3; set 1 to turn
# retrying off and see every transient failure as it happens. Retrying only
# ever absorbs failures that came back quickly, and never adds more than two
# seconds to a call - a request that used up its own timeout is not repeated.
RETRY_MAX_ATTEMPTS=
# Log level for the structured logger.
LOG_LEVEL=
# Metrics. Leave empty and no metrics listener is created and no extra port is
# published - which is the right default without a monitoring stack. Set it and
# use docker/compose.metrics.yaml alongside the base compose file.
# Ignored when MCP_TRANSPORT=stdio: several clients may each start their own
# process on one machine, and a listener would make the second one fail.
METRICS_PORT=
