# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
# Every value here is environment-specific and must never be committed.

# --- Required. The server refuses to start without these. ---
# Pre-shared bearer token that MCP clients must present.
MCP_AUTH_TOKEN=
# Comma-separated hostnames accepted in Host/Origin on the MCP route.
MCP_ALLOWED_HOSTS=
# The URL MCP clients connect to, including the path. Used by
# install_claude_plugin.sh; not read by the server itself.
# Example: https://mcp.example.com/mcp-searxng-crawl4ai
MCP_PUBLIC_ENDPOINT=
# SearXNG server.secret_key.
SEARXNG_SECRET=
# Crawl4AI API token. This is not optional: without it Crawl4AI binds only to
# loopback inside its own container and is unreachable from the MCP server,
# while still reporting itself healthy.
CRAWL4AI_API_TOKEN=

# --- Optional. Sensible defaults apply when unset. ---
# Port the MCP server listens on inside the container.
PORT=
# Credentials for LLM-backed structured extraction. When empty, web_extract
# degrades to returning page markdown and every other tool is unaffected.
GEMINI_API_KEY=
# LiteLLM-style provider/model identifier, e.g. gemini/<model>.
GEMINI_MODEL=
# Route outbound traffic through a relay. Empty means connect directly.
PROXY_URL=
# Extra CIDR ranges to allow as scrape targets, comma-separated. Private,
# loopback, link-local and metadata ranges are denied unless listed here.
SCRAPE_ALLOW_CIDRS=
# Maximum simultaneous page fetches. Lower this on low-power hosts.
MAX_CONCURRENT_FETCHES=
# Log level for the structured logger.
LOG_LEVEL=
