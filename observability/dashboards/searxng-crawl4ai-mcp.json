    {
      "type": "timeseries",
      "title": "Fetch slots",
      "description": "Slots pinned at the limit with refusals climbing means the host is the bottleneck, not the web.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 43
      },
      "id": 20,
      "datasource": {
        "type": "prometheus",
