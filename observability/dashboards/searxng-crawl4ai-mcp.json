      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "mcp_fetch_slots_in_use{job=\"$job\"}",
          "range": true,
          "refId": "A",
          "legendFormat": "in use"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "mcp_fetch_slots_limit{job=\"$job\"}",
          "range": true,
          "refId": "B",
          "legendFormat": "limit"
        },
        {
