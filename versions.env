# ============================================================================
# versions.env - the ONE place where upstream versions are declared.
#
# To move to a new upstream release, change a tag HERE and nowhere else.
# If a version change requires editing any other file, the design is broken.
#
# Tags must be immutable. Never use `latest`, `main`, `edge` or a bare major
# such as `0.9`: those float, so an unrelated redeploy months from now would
# silently pull a different image. tests/unit/versions.test.ts enforces this.
# ============================================================================

# SearXNG - metasearch engine. Official image, used as-is.
SEARXNG_IMAGE=searxng/searxng:2026.8.29-d226b78bc

# Crawl4AI - scraping backend. Official image, used as-is.
# We talk to its documented HTTP API only; we never import its Python API.
CRAWL4AI_IMAGE=unclecode/crawl4ai:0.9.2

# Base image used to build our own MCP server image (build stage only).
NODE_IMAGE=node:22.23.2-alpine3.24

# Serves the fixture site used by the contract tests. Test-only.
NGINX_IMAGE=nginx:1.29.4-alpine

# Our own MCP server image. Built and published by CI, pulled by the target
# host - the target host never builds. Same pinning discipline as upstream: the
# tag is a commit sha, so a deployed image maps to exactly one revision and a
# rollback is an older sha. Update it after the build workflow publishes.
#
# For local development, docker/compose.dev.yaml and compose.test.yaml build
# the image instead of pulling this one.
MCP_IMAGE=ghcr.io/siosig/searxng-crawl4ai-mcp:2dcec85c1f3ebe84f39b9cabb609495b114fe6cf

# The stack's private network. Declared here because two things must agree on
# it: docker/compose.yaml creates the network with it, and the deployment's
# packet filter blocks it from reaching the local network. If they drift apart
# the filter silently stops protecting anything.
STACK_SUBNET=172.28.6.0/24
