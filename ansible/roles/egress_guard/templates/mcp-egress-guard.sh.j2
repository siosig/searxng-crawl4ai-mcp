#!/bin/sh
# Managed by Ansible (egress_guard). Applies the stack's egress rules. Runs
# before docker.service, so it relies on nothing Docker creates, and it is safe
# to run repeatedly: each part replaces its own rules rather than adding to them.
set -eu

SRC="{{ egress_guard_source_subnet }}"
CHAIN="{{ egress_guard_input_chain }}"

# Routed traffic: the container reaching another machine.
nft -f /etc/mcp-egress-guard.nft

# Local delivery: the container reaching the host itself, on any of its
# addresses. That never passes the forward hook. Only new connections are
# dropped, so replies to connections the host opens into the stack still flow.
# This half is iptables because the nft equivalent needs nft_ct, which some
# kernels lack. Declaring the chain in a --noflush restore replaces its rules in
# one transaction.
#
# The jump must stay the first rule in INPUT: other services insert at the top
# as well, and a rule ahead of it could accept the stack's traffic. Every run
# deletes the existing jumps by their spec and inserts one at the top in the
# same transaction, so the jump is never missing and no other rule is touched.
JUMP="-s $SRC -j $CHAIN"
copies=$(iptables -w -S INPUT | grep -c -x -F -- "-A INPUT $JUMP" || true)
{
    echo "*filter"
    echo ":$CHAIN - [0:0]"
{% for dest in egress_guard_allowed_destinations %}
    echo "-A $CHAIN -d {{ dest }} -j RETURN"
{% endfor %}
    echo "-A $CHAIN -m conntrack --ctstate NEW -j DROP"
    i=0
    while [ "$i" -lt "$copies" ]; do
        echo "-D INPUT $JUMP"
        i=$((i + 1))
    done
    echo "-I INPUT 1 $JUMP"
    echo "COMMIT"
} | iptables-restore -w --noflush
