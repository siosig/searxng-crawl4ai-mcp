#!/bin/sh
# Managed by Ansible (egress_guard). Installs the stack's egress rules in
# DOCKER-USER. Safe to run repeatedly: a rule that is already present is kept.
set -eu

SRC="{{ egress_guard_source_subnet }}"
COMMENT="{{ egress_guard_comment }}"

# xt_comment is missing on some kernels; a rule must not depend on its label.
probe="MCP_COMMENT_PROBE"
iptables -w -N "$probe" 2>/dev/null || true
if iptables -w -A "$probe" -j RETURN -m comment --comment probe 2>/dev/null; then
    label=1
else
    label=0
fi
iptables -w -F "$probe" 2>/dev/null || true
iptables -w -X "$probe" 2>/dev/null || true

ensure() {
    action="$1"; dest="$2"; target="$3"; suffix="$4"
    if [ "$label" = 1 ]; then
        set -- -m comment --comment "$COMMENT$suffix"
    else
        set --
    fi
    if ! iptables -w -C DOCKER-USER -s "$SRC" -d "$dest" -j "$target" "$@" 2>/dev/null; then
        iptables -w "$action" DOCKER-USER -s "$SRC" -d "$dest" -j "$target" "$@"
    fi
}

{% for dest in egress_guard_allowed_destinations %}
ensure -I "{{ dest }}" RETURN " (allowed)"
{% endfor %}
{% for dest in egress_guard_blocked_destinations %}
ensure -A "{{ dest }}" DROP ""
{% endfor %}
