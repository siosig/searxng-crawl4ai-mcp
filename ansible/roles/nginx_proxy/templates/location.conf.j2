# Managed by Ansible.
#
# Only the MCP path is exposed. The unauthenticated information route stays on
# loopback: it is there for a local health probe, not for the world.
location {{ nginx_proxy_location }} {
    proxy_pass http://127.0.0.1:{{ mcp_port }}/mcp;
    proxy_http_version 1.1;

    proxy_set_header Host {{ mcp_public_hostname }};
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Streaming responses must not be buffered or they arrive all at once.
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout {{ nginx_proxy_read_timeout }}s;
    proxy_send_timeout {{ nginx_proxy_read_timeout }}s;
}
