# Managed by Ansible (nginx_proxy role).
#
# Public path -> the MCP server on loopback. Dropped into the existing HTTPS
# server block through its `include {{ nginx_proxy_locations_dir }}/*.conf;`.
#
# Authentication is the MCP server's job (it enforces MCP_AUTH_TOKEN); nginx
# only has to pass Authorization through untouched. The unauthenticated
# information route stays on loopback and is deliberately not exposed here.
location = {{ nginx_proxy_location }} {
    proxy_pass http://127.0.0.1:{{ mcp_port }}/mcp;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Streamable HTTP: send bytes as they are produced rather than collecting a
    # whole response first, and allow a long tool call to finish.
    proxy_buffering off;
    proxy_cache off;
    chunked_transfer_encoding on;
    proxy_connect_timeout 10s;
    proxy_read_timeout {{ nginx_proxy_read_timeout }}s;
    proxy_send_timeout {{ nginx_proxy_read_timeout }}s;
}
