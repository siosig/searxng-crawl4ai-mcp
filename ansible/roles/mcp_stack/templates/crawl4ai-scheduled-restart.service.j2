# Managed by Ansible. Do not edit on the host - changes are overwritten.
[Unit]
Description=Restart the crawl4ai container while it is idle
After=docker.service

[Service]
Type=oneshot
Environment=WATCHDOG_MODE=scheduled
Environment=WATCHDOG_CONTAINER={{ mcp_crawl4ai_container }}
{% if mcp_login_session_root | default('') | string | length > 0 %}
Environment=WATCHDOG_LOGIN_MARKER={{ mcp_login_session_root }}/state/login-in-progress
{% endif %}
ExecStart={{ mcp_deploy_dir }}/crawl4ai-watchdog
TimeoutStartSec=300
